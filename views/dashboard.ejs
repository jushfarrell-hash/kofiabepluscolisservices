<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="brand">
        <span class="brand-main">KOFIABE</span>
        <span class="brand-sub">COLIS SERVICES</span>
      </div>
      <div class="nav-links">
        <a class="active" href="/dashboard">Dashboard</a>
        <a href="/agencies">Agences</a>
        <a href="/shipments">Colis</a>
        <a href="/users">Comptes</a>
        <a href="/payments">Paiements</a>
        <a href="/tracking">Suivi</a>
        <a href="/logout">Déconnexion</a>
      </div>
    </div>
  </nav>

  <main class="container">
    <div class="page-header">
      <div>
        <h1>Bienvenue, <%= user.name %></h1>
      </div>
      <span class="status-pill"><%= user.role %></span>
    </div>

    <section class="grid">
      <div class="stat">
        <div class="label">Colis total</div>
        <div class="value"><%= stats.total_shipments || 0 %></div>
      </div>
      <div class="stat">
        <div class="label">Livrés</div>
        <div class="value"><%= stats.delivered || 0 %></div>
      </div>
      <div class="stat">
        <div class="label">En transit</div>
        <div class="value"><%= stats.in_transit || 0 %></div>
      </div>
      <div class="stat">
        <div class="label">Agences</div>
        <div class="value"><%= stats.total_agencies || 0 %></div>
      </div>
    </section>

    <div class="mt-4 card">
      <h2>Colis récents</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Code</th>
              <th>Expéditeur</th>
              <th>Destinataire</th>
              <th>Trajet</th>
              <th>Montant</th>
              <th>Statut</th>
            </tr>
          </thead>
          <tbody>
            <% shipments.forEach((shipment) => { %>
              <tr>
                <td><%= shipment.tracking_code %></td>
                <td><%= shipment.sender_name %></td>
                <td><%= shipment.recipient_name %></td>
                <td><%= shipment.from_city %> → <%= shipment.to_city %></td>
                <td><%= Number(shipment.amount || 0).toLocaleString('fr-FR') %> Ar</td>
                <td><span class="status-pill"><%= shipment.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
